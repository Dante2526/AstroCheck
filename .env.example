# ==========================================
# CREDENCIAIS DO FIREBASE (CLOUDFLARE PAGES)
# ==========================================
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="seu-projeto.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="seu-projeto-id"
VITE_FIREBASE_STORAGE_BUCKET="seu-projeto.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# ==========================================
# DISPARO DE E-MAIL VIA GMAIL (GOOGLE APPS SCRIPT) - RECOMENDADO (500-1500/DIA GRÁTIS)
# ==========================================
VITE_GOOGLE_SCRIPT_URL="https://script.google.com/macros/s/SEU_SCRIPT_ID/exec"

# ==========================================
# BIOMETRIA (WEBAUTHN)
# ==========================================
# Dominio registrado para WebAuthn.
# Em PRODUCAO: use o dominio final (ex: astrocheck.suaempresa.com.br)
# Em DEV/test: deixar vazio (usa window.location.hostname automaticamente)
# IMPORTANTE: rpId deve ser sufixo do dominio atual para nao dar SecurityError
# VITE_WEBAUTHN_RPID="astrocheck.suaempresa.com.br"

# ==========================================
# E-MAIL DOS GESTORES POR TURMA (OBRIGATORIO EM PRODUCAO)
# ==========================================
# Sem estas variaveis, requireGestorEmail retorna string vazia em PROD
# e todo envio falha com "Gestor da turma nao configurado".
VITE_GESTOR_EMAIL_A="gestor.a@suaempresa.com.br"
VITE_GESTOR_EMAIL_B="gestor.b@suaempresa.com.br"
VITE_GESTOR_EMAIL_C="gestor.c@suaempresa.com.br"
VITE_GESTOR_EMAIL_D="gestor.d@suaempresa.com.br"

# Nome do gestor exibido no email HTML (opcional - tem fallback)
VITE_GESTOR_NOME_A="Nome do Gestor A"
VITE_GESTOR_NOME_B="Nome do Gestor B"
VITE_GESTOR_NOME_C="Nome do Gestor C"
VITE_GESTOR_NOME_D="Nome do Gestor D"
